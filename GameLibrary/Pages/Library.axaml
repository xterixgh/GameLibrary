<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
			 x:Class="GameLibrary.Pages.Library"
			 x:CompileBindings="False">
	<Grid RowDefinitions="Auto,*">
		<Border Classes="topbar" Grid.Row="0">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Spacing="4" VerticalAlignment="Center">
					<TextBlock Classes="h2" Text="Моя библиотека"/>
					<TextBlock x:Name="UserInfoText" Classes="muted"/>
				</StackPanel>

				<StackPanel Grid.Column="1"
							Orientation="Horizontal"
							Spacing="8"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
					<Button x:Name="ThemeButton" Classes="ghost" Content="Светлая тема" Click="ThemeButton_Click"/>
					<Button Classes="ghost" Content="Обновить" Click="RefreshButton_Click"/>
					<Button Classes="ghost" Content="Статистика" Click="StatsButton_Click"/>
					<Button Classes="primary" Content="Добавить" Click="AddButton_Click"/>
					<Button Classes="ghost" Content="Изменить" Click="EditButton_Click"/>
					<Button Classes="primary" Content="Играть" Click="PlayButton_Click"/>
					<Button Classes="ghost" Content="Подробнее" Click="DetailsButton_Click"/>
					<Button Classes="danger" Content="Удалить" Click="DeleteButton_Click"/>
					<Button Classes="danger" Content="Выход" Click="LogoutButton_Click"/>
				</StackPanel>
			</Grid>
		</Border>

		<Border Classes="panel" Grid.Row="1" Margin="20">
			<Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
				<StackPanel Orientation="Horizontal" Spacing="10">
					<TextBox x:Name="SearchBox"
							 Width="240"
							 PlaceholderText="Поиск по названию"/>
					<ComboBox x:Name="StatusFilterBox"
							  Width="180"
							  PlaceholderText="Все статусы">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<CheckBox x:Name="WishlistFilterBox"
							  Content="Только wishlist"
							  VerticalAlignment="Center"/>
					<Button Classes="primary" Content="Найти" Click="FilterButton_Click"/>
					<Button Classes="ghost" Content="Сбросить" Click="ResetFilterButton_Click"/>
				</StackPanel>

				<TextBlock x:Name="StatusText"
						   Classes="muted"
						   Text="Загрузка..."
						   Grid.Row="1"/>

				<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl x:Name="GamesList">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel ItemWidth="220" ItemHeight="380"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Classes="gamecard"
										Margin="6"
										Tag="{Binding}"
										PointerPressed="Card_PointerPressed"
										DoubleTapped="Card_DoubleTapped">
									<StackPanel>
										<Border Classes="coverplace">
											<Panel>
												<TextBlock Classes="coverletter"
														   Text="{Binding Letter}"
														   IsVisible="{Binding ShowPlaceholder}"/>
												<Image Source="{Binding Cover}"
													   Stretch="UniformToFill"
													   IsVisible="{Binding HasCover}"/>
											</Panel>
										</Border>
										<StackPanel Margin="12,10,12,12" Spacing="4">
											<TextBlock Text="{Binding Game.Title}"
													   FontWeight="SemiBold"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Classes="muted" Text="{Binding StatusName}"/>
											<TextBlock Classes="muted" Text="{Binding Meta}"/>
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>
	</Grid>
</UserControl>
