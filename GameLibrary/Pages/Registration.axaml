<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameLibrary.Pages.Registration">

    <Grid>
        <Border Classes="card"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Classes="h1" Text="Регистрация"/>
                <TextBlock Text="Логин от 3 символов, пароль от 6."/>

                <TextBox x:Name="LoginBox" PlaceholderText="Логин"/>
                <TextBox x:Name="PasswordBox" PlaceholderText="Пароль" PasswordChar="•"/>
                <TextBox x:Name="ConfirmBox" PlaceholderText="Пароль ещё раз" PasswordChar="•"/>

                <TextBlock x:Name="ErrorText" Classes="error" IsVisible="False"/>

                <Button Classes="primary"
                        Content="Создать аккаунт"
                        HorizontalAlignment="Stretch"
                        Click="RegisterButton_Click"/>
                <Button Classes="ghost"
                        Content="Назад ко входу"
                        HorizontalAlignment="Center"
                        Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
